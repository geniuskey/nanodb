# Keep the build context small and, importantly, keep source sample data and
# runtime state out of the image. Only paths explicitly COPYed in the Dockerfile
# are used; everything here is excluded from the build context.

.git
.gitignore
.gitattributes

# Runtime state and local artifacts
var/
dist/
.venv/
node_modules/
**/node_modules/
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# Source sample data must never enter the image
data/

# Docs, tests, tooling and references not needed at runtime
aidlc-docs/
references/
# The frontend build imports the horizontal logo from assets/logo/ and the intro
# video from assets/video/, so those two directories are re-included; they are
# consumed by the frontend build stage only and never reach the runtime image,
# which copies just dist/frontend.
assets/
!assets/logo/
!assets/video/
tests/
scripts/
validation/
.agents/
.aidlc-rule-details/
.claude/

# Local environment files
.env
