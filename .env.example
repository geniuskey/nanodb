# NANoDB Core environment example. Copy to .env and adjust as needed.
# .env is git-ignored; never commit real secrets.

# --- Database ---------------------------------------------------------------
# App connection string. Inside Compose the host is the db service; for host-side
# tooling (demo seeding, reset) against the Compose database use 127.0.0.1.
DATABASE_URL=postgresql+psycopg://nanodb:nanodb@127.0.0.1:5432/nanodb

# PostgreSQL container credentials/database (used by the db service).
POSTGRES_USER=nanodb
POSTGRES_PASSWORD=nanodb
POSTGRES_DB=nanodb

# Connection pool tuning.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10

# --- Storage ----------------------------------------------------------------
# Directory that owns registered image binaries. Native default is var/uploads;
# the app container uses /data/uploads bind-mounted to ./var/uploads.
UPLOAD_ROOT=var/uploads

# --- Runtime profile --------------------------------------------------------
# "demo" enables the guarded demo seeding and reset entry points. The reset
# tooling refuses to run unless NANODB_PROFILE=demo.
NANODB_PROFILE=demo

# Built frontend location served same-origin by the app.
FRONTEND_DIST=dist/frontend

# Logging level.
LOG_LEVEL=INFO

# --- Published ports (loopback only) ----------------------------------------
APP_PORT=8000
DB_PORT=5432
