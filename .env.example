# NANoDB Core environment example. Copy to .env and adjust as needed.
# .env is git-ignored; never commit real secrets.

# --- Database ---------------------------------------------------------------
# Host-side connection string, used by native runs and by demo seeding/reset
# against the Compose database. Containers do NOT use this value: 127.0.0.1
# inside a container is the container itself. Keep it host-oriented.
DATABASE_URL=postgresql+psycopg://nanodb:nanodb@127.0.0.1:5432/nanodb

# Connection string used by the migrate/app containers. Leave unset to use the
# Compose default (the db service hostname); set it only to point the stack at
# an external database. If you change DB_PORT, change the port in DATABASE_URL
# above to match -- APP_DATABASE_URL talks to db:5432 on the Compose network.
# APP_DATABASE_URL=postgresql+psycopg://nanodb:nanodb@db:5432/nanodb

# PostgreSQL container credentials/database (used by the db service).
POSTGRES_USER=nanodb
POSTGRES_PASSWORD=nanodb
POSTGRES_DB=nanodb

# Connection pool tuning.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10

# --- Storage ----------------------------------------------------------------
# Directory that owns registered image binaries. Native default is var/uploads;
# the app container uses /data/uploads bind-mounted to ./var/uploads.
UPLOAD_ROOT=var/uploads

# --- Runtime profile --------------------------------------------------------
# "demo" enables the guarded demo seeding and reset entry points. The reset
# tooling refuses to run unless NANODB_PROFILE=demo.
NANODB_PROFILE=demo

# Built frontend location served same-origin by the app.
FRONTEND_DIST=dist/frontend

# Logging level.
LOG_LEVEL=INFO

# --- Published ports (loopback only) ----------------------------------------
APP_PORT=8000
DB_PORT=5432
